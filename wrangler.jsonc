{
  "name": "hoopland-premium-class-generator",
  "main": "location-worker.js",
  "compatibility_date": "2026-11-13",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
