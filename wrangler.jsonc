{
  "name": "hoopland-premium-class-generator",
  "main": "location-worker.js",
  "compatibility_date": "2026-11-13",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },

  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "APPEARANCES", "class_name": "SharedAppearance" }]
    }
  },

  "durable_objects": {
    "bindings": [{ "name": "APPEARANCES", "class_name": "SharedAppearance" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SharedAppearance"] }],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
